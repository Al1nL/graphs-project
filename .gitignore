__pycache__/
*.py[cod]

# Precomputed PE tensors and raw LRGB downloads -- regenerate with src/pe/compute_pe.py
cache/
raw_data/

# Run outputs. Checkpoints (results/raw/) and per-job SLURM logs (results/slurm_logs/)
# are large and reproducible from a rerun -- excluded via the blanket results/* below.
# Everything else small and real -- per-cell result JSONs, the calibration sweep
# outputs, the per-cell run CSVs, and the job_id<->cell tracking sheet -- is un-ignored
# explicitly so it can be committed and shared with teammates without `git add -f`.
results/*
!results/.gitkeep
!results/graphormer_*.json
!results/calibration_*.csv
!results/calibration_*.png
!results/runs_graphormer_*.csv
!results/job_ids.csv

.venv/
venv/
.ipynb_checkpoints/
.DS_Store
