__pycache__/
*.py[cod]

# Precomputed PE tensors and raw LRGB downloads -- regenerate with src/pe/compute_pe.py
cache/
raw_data/

# Run outputs. results/*.json are produced by run_experiment.py; keep the dir, not the
# runs. Must be `results/*`, not `results/`: git never descends into an EXCLUDED
# directory, so with the latter the negation below can never fire.
results/*
!results/.gitkeep

.venv/
venv/
.ipynb_checkpoints/
.DS_Store

# Cluster job output (scripts/slurm/, run_job.sh) and training checkpoints.
logs/
*.pt
*.tmp

# Generated by scripts/generate_san_configs.py from san_backend.py's PE_SPEC --
# regenerate rather than edit, so the configs cannot drift from the model code.
configs/san/*.json
