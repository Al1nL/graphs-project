{
  "_comment": "SAN config: PE=rwse, dataset=peptides-struct. Base structure follows SAN's own configs/*.json (github.com/DevinKreuzer/SAN).",
  "out_dir": "results/raw/san_rwse_peptides-struct",
  "dataset": "peptides-struct",
  "params": {
    "seed_placeholder": "set via --seed on CLI wrapper",
    "epochs": 200,
    "batch_size": 32,
    "init_lr": 0.0007,
    "lr_reduce_factor": 0.5,
    "lr_schedule_patience": 10,
    "min_lr": 1e-6,
    "weight_decay": 0.0
  },
  "net_params": {
    "L": 10,
    "hidden_dim": 80,
    "out_dim": 80,
    "n_heads": 8,
    "full_graph": true,
    "gamma": 1e-5,
    "in_feat_dropout": 0.0,
    "dropout": 0.0,
    "layer_norm": false,
    "batch_norm": true,
    "lpe_enable": true,
    "lpe_dim": 16,
    "lpe_n_heads": 4,
    "lpe_layers": 2,
    "signnet_replaces_lpe": false,
    "extra_node_feat": "rwse",
    "grpe_bias_enable": false,
    "grpe_spd_cap": 20
  },
  "pe_cache": "cache/peptides-struct/{split}_pe.pt"
}
